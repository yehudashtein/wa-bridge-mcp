# ── wa-bridge-mcp configuration ──────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in. The MCP reads these from the process
# environment — in Claude Desktop/Code set them in the server's `env` block.

# The WhatsApp bridge base URL (include the /v1). Defaults to the cloud instance.
WHATSAPP_BRIDGE_URL=https://api.api-supp.com/v1

# Your tenant bearer token (looks like wat_...). You receive this during
# onboarding — it scopes the MCP to your own WhatsApp account only. SERVER-ONLY,
# never commit the real value.
WHATSAPP_BRIDGE_TOKEN=wat_your_tenant_token_here

# Optional: per-request HTTP timeout in seconds (default 30).
# WHATSAPP_HTTP_TIMEOUT=30
